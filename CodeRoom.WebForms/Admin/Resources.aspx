<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="Resources.aspx.cs" Inherits="CodeRoom.WebForms.Admin.Resources" MasterPageFile="~/Site.Master" %>
<asp:Content ID="cTitle" ContentPlaceHolderID="TitleContent" runat="server">Manage Resources - Code-Room</asp:Content>
<asp:Content ID="cBody" ContentPlaceHolderID="MainContent" runat="server"><section class="page-shell"><div class="container"><div class="admin-crud-header"><div><span class="eyebrow">RESOURCES</span><h1 class="page-title">Manage resources</h1></div><a class="btn btn-primary" href='<%= ResolveUrl("~/Admin/ResourcesCreate.aspx") %>'>+ New resource</a></div><div class="content-panel"><table class="data-table"><thead><tr><th>Title</th><th>Type</th><th>Course</th><th>URL</th><th>Actions</th></tr></thead><tbody><asp:Repeater ID="ResourcesRepeater" runat="server"><ItemTemplate><tr><td><%#: Eval("Title") %></td><td><%#: Eval("Type") %></td><td><%#: Eval("CourseTitle") %></td><td><a href='<%#: Eval("Url") %>' target="_blank" rel="noopener">Open</a></td><td class="row-actions"><a class="btn btn-secondary btn-sm" href='<%# ResolveUrl("~/Admin/ResourcesEdit.aspx?id=" + Eval("Id")) %>'>Edit</a><asp:Button ID="DeleteButton" runat="server" CssClass="btn btn-danger btn-sm" Text="Delete" CommandArgument='<%# Eval("Id") %>' OnCommand="DeleteButton_Command" CausesValidation="false" OnClientClick="return confirm('Delete this resource?');" /></td></tr></ItemTemplate></asp:Repeater><asp:Panel ID="EmptyPanel" runat="server"><tr><td colspan="5">No resources yet.</td></tr></asp:Panel></tbody></table></div></div></section></asp:Content>