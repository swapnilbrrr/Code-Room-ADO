<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="ResourcesEdit.aspx.cs" Inherits="CodeRoom.WebForms.Admin.ResourcesEdit" MasterPageFile="~/Site.Master" %>
<asp:Content ID="cTitle" ContentPlaceHolderID="TitleContent" runat="server">Edit Resource - Code-Room</asp:Content>
<asp:Content ID="cBody" ContentPlaceHolderID="MainContent" runat="server"><section class="page-shell"><div class="container narrow"><span class="eyebrow">RESOURCES</span><h1 class="page-title">Edit resource</h1><div class="content-panel"><asp:ValidationSummary ID="Summary" runat="server" CssClass="validation-summary" /><asp:HiddenField ID="ResourceId" runat="server" /><div class="form-grid"><label class="form-field">Title<asp:TextBox ID="Title" runat="server" CssClass="input" /><asp:RequiredFieldValidator ID="TitleRequired" runat="server" ControlToValidate="Title" ErrorMessage="Title is required." CssClass="field-error" /></label><label class="form-field">Type<asp:DropDownList ID="Type" runat="server" CssClass="input"><asp:ListItem>Document</asp:ListItem><asp:ListItem>Link</asp:ListItem><asp:ListItem>Video</asp:ListItem><asp:ListItem>Audio</asp:ListItem><asp:ListItem>PDF</asp:ListItem><asp:ListItem>Learning</asp:ListItem><asp:ListItem>Exam Prep</asp:ListItem><asp:ListItem>Security</asp:ListItem></asp:DropDownList></label><label class="form-field form-field-wide">URL<asp:TextBox ID="Url" runat="server" CssClass="input" /><asp:RequiredFieldValidator ID="UrlRequired" runat="server" ControlToValidate="Url" ErrorMessage="URL is required." CssClass="field-error" /><asp:CustomValidator ID="UrlValidator" runat="server" ControlToValidate="Url" OnServerValidate="ValidateUrl" ErrorMessage="Enter a valid HTTP or HTTPS URL." CssClass="field-error" /></label><label class="form-field">Course (optional)<asp:DropDownList ID="CourseId" runat="server" CssClass="input" /></label></div><div class="form-actions"><a class="btn btn-ghost" href='<%= ResolveUrl("~/Admin/Resources.aspx") %>'>Cancel</a><asp:Button ID="SaveButton" runat="server" CssClass="btn btn-primary" Text="Save changes" OnClick="SaveButton_Click" /></div></div></div></section></asp:Content>