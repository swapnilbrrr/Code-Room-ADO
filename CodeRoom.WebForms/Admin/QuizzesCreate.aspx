<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="QuizzesCreate.aspx.cs" Inherits="CodeRoom.WebForms.Admin.QuizzesCreate" MasterPageFile="~/Site.Master" %>
<asp:Content ID="cTitle" ContentPlaceHolderID="TitleContent" runat="server">New Quiz - Code-Room</asp:Content>
<asp:Content ID="cBody" ContentPlaceHolderID="MainContent" runat="server"><section class="page-shell"><div class="container narrow"><span class="eyebrow">QUIZZES</span><h1 class="page-title">New quiz</h1><div class="content-panel"><asp:ValidationSummary ID="Summary" runat="server" CssClass="validation-summary" /><div class="form-grid"><label class="form-field">Course<asp:DropDownList ID="CourseId" runat="server" CssClass="input" /><asp:RequiredFieldValidator ID="CourseRequired" runat="server" ControlToValidate="CourseId" InitialValue="" ErrorMessage="Select a course." CssClass="field-error" /></label><label class="form-field">Title<asp:TextBox ID="Title" runat="server" CssClass="input" /><asp:RequiredFieldValidator ID="TitleRequired" runat="server" ControlToValidate="Title" ErrorMessage="Title is required." CssClass="field-error" /><asp:CustomValidator ID="TitleRules" runat="server" ControlToValidate="Title" OnServerValidate="ValidateTitle" ErrorMessage="Title must be between 3 and 150 characters." CssClass="field-error" /></label><label class="form-field">Assessment type<asp:DropDownList ID="AssessmentType" runat="server" CssClass="input"><asp:ListItem>Quiz</asp:ListItem><asp:ListItem>Assessment</asp:ListItem><asp:ListItem>Final Exam</asp:ListItem></asp:DropDownList></label><label class="form-field">Time limit (minutes)<asp:TextBox ID="TimeLimit" runat="server" CssClass="input" /><asp:CustomValidator ID="TimeRules" runat="server" ControlToValidate="TimeLimit" OnServerValidate="ValidateTime" ErrorMessage="Time limit must be between 0 and 180 minutes." CssClass="field-error" /></label><label class="form-field">Passing score (%)<asp:TextBox ID="PassingScore" runat="server" CssClass="input" Text="70" /><asp:CustomValidator ID="PassingRules" runat="server" ControlToValidate="PassingScore" OnServerValidate="ValidatePassing" ErrorMessage="Passing score must be between 0 and 100." CssClass="field-error" /></label><label class="checkbox-row"><asp:CheckBox ID="IsCertificationExam" runat="server" /><span>Certification examination</span></label><label class="form-field form-field-wide">Description<asp:TextBox ID="Description" runat="server" CssClass="input" TextMode="MultiLine" Rows="3" /></label></div><div class="form-actions"><a class="btn btn-ghost" href='<%= ResolveUrl("~/Admin/Quizzes.aspx") %>'>Cancel</a><asp:Button ID="SaveButton" runat="server" CssClass="btn btn-primary" Text="Create quiz" OnClick="SaveButton_Click" /></div></div></div></section></asp:Content>