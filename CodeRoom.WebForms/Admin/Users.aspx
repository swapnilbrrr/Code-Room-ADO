<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="Users.aspx.cs" Inherits="CodeRoom.WebForms.Admin.Users" MasterPageFile="~/Site.Master" %>
<asp:Content ID="cTitle" ContentPlaceHolderID="TitleContent" runat="server">Manage Users - Code-Room</asp:Content>
<asp:Content ID="cBody" ContentPlaceHolderID="MainContent" runat="server"><section class="page-shell"><div class="container"><div class="admin-crud-header"><div><span class="eyebrow">USERS</span><h1 class="page-title">Manage users</h1></div><div class="admin-header-meta"><a class="admin-badge admin-badge-link" href='<%= ResolveUrl("~/Admin/Audit.aspx") %>'>Audit log</a><a class="btn btn-primary" href='<%= ResolveUrl("~/Admin/UsersCreate.aspx") %>'>+ New user</a></div></div><div class="content-panel"><div class="admin-table-toolbar"><input class="input" type="search" placeholder="Search name, username or email…" data-admin-user-search /></div><div class="data-table-wrap"><table class="data-table" data-admin-user-table><thead><tr><th>Name</th><th>Username</th><th>Email</th><th>Role</th><th>Joined</th><th>Actions</th></tr></thead><tbody><asp:Repeater ID="UsersRepeater" runat="server"><ItemTemplate><tr data-user-row><td><%#: Eval("FullName") %></td><td><code>@<%#: Eval("Username") %></code></td><td><%#: Eval("Email") %></td><td><span class='role-pill role-<%# Eval("Role").ToString().ToLowerInvariant() %>'><%# Eval("Role") %></span></td><td><%# FormatDate(Eval("CreatedAt")) %></td><td class="row-actions"><a class="btn btn-secondary btn-sm" href='<%# ResolveUrl("~/Admin/UsersEdit.aspx?id=" + Eval("Id")) %>'>Edit</a><asp:Button ID="DeleteButton" runat="server" CssClass="btn btn-danger btn-sm" Text="Delete" CommandArgument='<%# Eval("Id") %>' OnCommand="DeleteButton_Command" CausesValidation="false" OnClientClick="return confirm('Delete this user?');" /></td></tr></ItemTemplate></asp:Repeater></tbody></table></div></div></div></section></asp:Content>
<asp:Content ID="cScripts" ContentPlaceHolderID="ScriptsContent" runat="server"><script>
(function(){var input=document.querySelector('[data-admin-user-search]');if(!input)return;input.addEventListener('input',function(){var q=input.value.toLowerCase().trim();document.querySelectorAll('[data-user-row]').forEach(function(row){row.style.display=row.textContent.toLowerCase().indexOf(q)>=0?'':'none';});});})();
</script></asp:Content>