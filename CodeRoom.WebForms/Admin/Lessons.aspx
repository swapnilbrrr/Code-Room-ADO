<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="Lessons.aspx.cs" Inherits="CodeRoom.WebForms.Admin.Lessons" MasterPageFile="~/Site.Master" %>
<asp:Content ID="cTitle" ContentPlaceHolderID="TitleContent" runat="server">Manage Lessons - Code-Room</asp:Content>
<asp:Content ID="cBody" ContentPlaceHolderID="MainContent" runat="server"><section class="page-shell"><div class="container"><div class="admin-crud-header"><div><span class="eyebrow">LESSONS</span><h1 class="page-title">Manage lessons</h1></div><a class="btn btn-primary" href='<%= ResolveUrl("~/Admin/LessonsCreate.aspx") %>'>+ New lesson</a></div><div class="content-panel"><div class="filter-bar"><label>Filter by course<asp:DropDownList ID="CourseFilter" runat="server" CssClass="input" AutoPostBack="true" OnSelectedIndexChanged="CourseFilter_Changed" /></label></div><table class="data-table"><thead><tr><th>#</th><th>Title</th><th>Course</th><th>Status</th><th>Actions</th></tr></thead><tbody><asp:Repeater ID="LessonsRepeater" runat="server"><ItemTemplate><tr><td><%# Eval("Order") %></td><td><%# Eval("Title") %></td><td><%# Eval("Course.Title") %></td><td><%# Convert.ToBoolean(Eval("IsPublished")) ? "Published" : "Draft" %></td><td class="row-actions"><a class="btn btn-secondary btn-sm" href='<%# ResolveUrl("~/Admin/LessonsEdit.aspx?id=" + Eval("Id")) %>'>Edit</a><asp:Button ID="DeleteButton" runat="server" CssClass="btn btn-danger btn-sm" Text="Delete" CommandArgument='<%# Eval("Id") %>' OnCommand="DeleteButton_Command" CausesValidation="false" OnClientClick="return confirm('Delete this lesson?');' /></td></tr></ItemTemplate></asp:Repeater><asp:Panel ID="EmptyPanel" runat="server"><tr><td colspan="5">No lessons found.</td></tr></asp:Panel></tbody></table></div></div></section></asp:Content>