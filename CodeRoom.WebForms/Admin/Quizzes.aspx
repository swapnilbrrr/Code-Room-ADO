<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="Quizzes.aspx.cs" Inherits="CodeRoom.WebForms.Admin.Quizzes" MasterPageFile="~/Site.Master" %>
<asp:Content ID="cTitle" ContentPlaceHolderID="TitleContent" runat="server">Manage Quizzes - Code-Room</asp:Content>
<asp:Content ID="cBody" ContentPlaceHolderID="MainContent" runat="server"><section class="page-shell"><div class="container"><div class="admin-crud-header"><div><span class="eyebrow">QUIZZES</span><h1 class="page-title">Manage quizzes</h1></div><a class="btn btn-primary" href='<%= ResolveUrl("~/Admin/QuizzesCreate.aspx") %>'>+ New quiz</a></div><div class="content-panel"><table class="data-table"><thead><tr><th>Title</th><th>Course</th><th>Questions</th><th>Actions</th></tr></thead><tbody><asp:Repeater ID="QuizzesRepeater" runat="server"><ItemTemplate><tr><td><%# Eval("Title") %></td><td><%# Eval("Course.Title") %></td><td><%# Eval("QuestionCount") %></td><td class="row-actions"><a class="btn btn-secondary btn-sm" href='<%# ResolveUrl("~/Admin/QuizzesManage.aspx?id=" + Eval("Id")) %>'>Questions</a><a class="btn btn-secondary btn-sm" href='<%# ResolveUrl("~/Admin/QuizzesEdit.aspx?id=" + Eval("Id")) %>'>Edit</a><asp:Button ID="DeleteButton" runat="server" CssClass="btn btn-danger btn-sm" Text="Delete" CommandArgument='<%# Eval("Id") %>' OnCommand="DeleteButton_Command" CausesValidation="false" OnClientClick="return confirm('Delete this quiz and all its questions?');" /></td></tr></ItemTemplate></asp:Repeater><asp:Panel ID="EmptyPanel" runat="server"><tr><td colspan="4">No quizzes yet.</td></tr></asp:Panel></tbody></table></div></div></section></asp:Content>