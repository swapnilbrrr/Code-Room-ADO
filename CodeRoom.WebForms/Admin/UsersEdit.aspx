<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="UsersEdit.aspx.cs" Inherits="CodeRoom.WebForms.Admin.UsersEdit" MasterPageFile="~/Site.Master" %>
<asp:Content ID="cTitle" ContentPlaceHolderID="TitleContent" runat="server">Edit User - Code-Room</asp:Content>
<asp:Content ID="cBody" ContentPlaceHolderID="MainContent" runat="server"><section class="page-shell"><div class="container narrow"><span class="eyebrow">USERS</span><h1 class="page-title">Edit user</h1><div class="content-panel"><asp:ValidationSummary ID="Summary" runat="server" CssClass="validation-summary" /><asp:HiddenField ID="UserId" runat="server" /><div class="form-grid"><label class="form-field">Full name<asp:TextBox ID="FullName" runat="server" CssClass="input" /><asp:RequiredFieldValidator ID="FullRequired" runat="server" ControlToValidate="FullName" ErrorMessage="Full name is required." CssClass="field-error" /></label><label class="form-field">Username<asp:TextBox ID="Username" runat="server" CssClass="input" /><asp:RequiredFieldValidator ID="UsernameRequired" runat="server" ControlToValidate="Username" ErrorMessage="Username is required." CssClass="field-error" /></label><label class="form-field">Email<asp:TextBox ID="Email" runat="server" CssClass="input" /><asp:RequiredFieldValidator ID="EmailRequired" runat="server" ControlToValidate="Email" ErrorMessage="Email is required." CssClass="field-error" /></label><label class="form-field">Role<asp:DropDownList ID="Role" runat="server" CssClass="input"><asp:ListItem Value="Student">Student</asp:ListItem><asp:ListItem Value="Admin">Admin</asp:ListItem><asp:ListItem Value="SuperAdmin">SuperAdmin</asp:ListItem></asp:DropDownList></label><label class="form-field">New password (leave blank to keep)<asp:TextBox ID="Password" runat="server" CssClass="input" TextMode="Password" /><asp:CustomValidator ID="PasswordRules" runat="server" ControlToValidate="Password" OnServerValidate="ValidatePassword" ErrorMessage="Password must be at least 8 characters." CssClass="field-error" /></label></div><div class="form-actions"><a class="btn btn-ghost" href='<%= ResolveUrl("~/Admin/Users.aspx") %>'>Cancel</a><asp:Button ID="SaveButton" runat="server" CssClass="btn btn-primary" Text="Save changes" OnClick="SaveButton_Click" /></div></div></div></section></asp:Content>