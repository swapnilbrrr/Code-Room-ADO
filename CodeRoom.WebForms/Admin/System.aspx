<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="System.aspx.cs" Inherits="CodeRoom.WebForms.Admin.System" MasterPageFile="~/Site.Master" %>
<asp:Content ID="cTitle" ContentPlaceHolderID="TitleContent" runat="server">SuperAdmin Workspace - Code-Room</asp:Content>
<asp:Content ID="cBody" ContentPlaceHolderID="MainContent" runat="server"><section class="page-shell admin-dashboard"><div class="container"><div class="admin-header"><div><span class="eyebrow">SUPER ADMINISTRATOR</span><h1 class="page-title">System governance</h1><p class="page-intro">Higher-level controls for account governance, platform oversight and administrative traceability.</p></div><a class="btn btn-secondary" href='<%= ResolveUrl("~/Admin/Dashboard.aspx") %>'>Back to Admin Console</a></div><div class="admin-stat-grid"><article class="admin-stat"><span class="admin-stat-label">Users</span><strong><asp:Literal ID="UserCount" runat="server" /></strong><small>Total registered accounts</small></article><article class="admin-stat"><span class="admin-stat-label">Admins</span><strong><asp:Literal ID="AdminCount" runat="server" /></strong><small>Administrator accounts</small></article><article class="admin-stat"><span class="admin-stat-label">SuperAdmins</span><strong><asp:Literal ID="SuperAdminCount" runat="server" /></strong><small>Highest-trust accounts</small></article><article class="admin-stat"><span class="admin-stat-label">Courses</span><strong><asp:Literal ID="CourseCount" runat="server" /></strong><small>Learning catalogue items</small></article><article class="admin-stat"><span class="admin-stat-label">Certificates</span><strong><asp:Literal ID="CertificateCount" runat="server" /></strong><small>Credentials issued</small></article></div><div class="admin-module-grid"><article class="admin-module admin-super-module"><span class="admin-module-icon">01</span><h3>Role governance</h3><p>Only SuperAdministrators can grant or edit privileged administrative roles.</p><a class="btn btn-secondary" href='<%= ResolveUrl("~/Admin/Users.aspx") %>'>Open users</a></article><article class="admin-module"><span class="admin-module-icon">02</span><h3>Audit trail</h3><p><asp:Literal ID="AuditCount" runat="server" /> platform administration events are available for review.</p><a class="btn btn-secondary" href='<%= ResolveUrl("~/Admin/Audit.aspx") %>'>Review audit</a></article><article class="admin-module"><span class="admin-module-icon">03</span><h3>Platform oversight</h3><p>Review catalogue, certificates and administrative activity from the main console.</p><a class="btn btn-secondary" href='<%= ResolveUrl("~/Admin/Dashboard.aspx") %>'>Open console</a></article></div></div></section></asp:Content>