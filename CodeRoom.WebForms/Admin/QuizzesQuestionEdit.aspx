<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="QuizzesQuestionEdit.aspx.cs" Inherits="CodeRoom.WebForms.Admin.QuizzesQuestionEdit" MasterPageFile="~/Site.Master" %>
<asp:Content ID="cTitle" ContentPlaceHolderID="TitleContent" runat="server">Edit Question - Code-Room</asp:Content>
<asp:Content ID="cBody" ContentPlaceHolderID="MainContent" runat="server"><section class="page-shell"><div class="container narrow"><span class="eyebrow">QUIZZES</span><h1 class="page-title">Edit question</h1><div class="content-panel"><asp:ValidationSummary ID="Summary" runat="server" CssClass="validation-summary" /><asp:HiddenField ID="QuestionId" runat="server" /><asp:HiddenField ID="QuizId" runat="server" /><div class="form-grid"><label class="form-field form-field-wide">Question<asp:TextBox ID="QuestionText" runat="server" CssClass="input" /><asp:RequiredFieldValidator ID="QuestionRequired" runat="server" ControlToValidate="QuestionText" ErrorMessage="Question text is required." CssClass="field-error" /></label><label class="form-field">Option A<asp:TextBox ID="OptionA" runat="server" CssClass="input" /><asp:RequiredFieldValidator ID="ARequired" runat="server" ControlToValidate="OptionA" ErrorMessage="Option A is required." CssClass="field-error" /></label><label class="form-field">Option B<asp:TextBox ID="OptionB" runat="server" CssClass="input" /><asp:RequiredFieldValidator ID="BRequired" runat="server" ControlToValidate="OptionB" ErrorMessage="Option B is required." CssClass="field-error" /></label><label class="form-field">Option C<asp:TextBox ID="OptionC" runat="server" CssClass="input" /><asp:RequiredFieldValidator ID="CRequired" runat="server" ControlToValidate="OptionC" ErrorMessage="Option C is required." CssClass="field-error" /></label><label class="form-field">Option D<asp:TextBox ID="OptionD" runat="server" CssClass="input" /><asp:RequiredFieldValidator ID="DRequired" runat="server" ControlToValidate="OptionD" ErrorMessage="Option D is required." CssClass="field-error" /></label><label class="form-field">Correct option<asp:DropDownList ID="CorrectOption" runat="server" CssClass="input"><asp:ListItem>A</asp:ListItem><asp:ListItem>B</asp:ListItem><asp:ListItem>C</asp:ListItem><asp:ListItem>D</asp:ListItem></asp:DropDownList></label></div><div class="form-actions"><a id="CancelLink" runat="server" class="btn btn-ghost">Cancel</a><asp:Button ID="SaveButton" runat="server" CssClass="btn btn-primary" Text="Save changes" OnClick="SaveButton_Click" /></div></div></div></section></asp:Content>