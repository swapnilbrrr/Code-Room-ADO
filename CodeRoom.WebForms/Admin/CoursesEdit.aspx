<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="CoursesEdit.aspx.cs" Inherits="CodeRoom.WebForms.Admin.CoursesEdit" MasterPageFile="~/Site.Master" %>
<asp:Content ID="cTitle" ContentPlaceHolderID="TitleContent" runat="server">Edit Course - Code-Room</asp:Content>
<asp:Content ID="cBody" ContentPlaceHolderID="MainContent" runat="server"><section class="page-shell"><div class="container narrow"><span class="eyebrow">COURSES</span><h1 class="page-title">Edit course</h1><div class="content-panel"><asp:ValidationSummary ID="Summary" runat="server" CssClass="validation-summary" /><asp:HiddenField ID="CourseId" runat="server" /><div class="form-grid"><label class="form-field">Title<asp:TextBox ID="Title" runat="server" CssClass="input" /><asp:RequiredFieldValidator ID="TitleRequired" runat="server" ControlToValidate="Title" ErrorMessage="Title is required." CssClass="field-error" Display="Dynamic" /><asp:CustomValidator ID="TitleRules" runat="server" ControlToValidate="Title" OnServerValidate="ValidateTitle" ErrorMessage="Title must be between 3 and 120 characters." CssClass="field-error" Display="Dynamic" /></label><label class="form-field">Slug (url-friendly)<asp:TextBox ID="Slug" runat="server" CssClass="input" /><asp:RequiredFieldValidator ID="SlugRequired" runat="server" ControlToValidate="Slug" ErrorMessage="Slug is required." CssClass="field-error" Display="Dynamic" /><asp:CustomValidator ID="SlugRules" runat="server" ControlToValidate="Slug" OnServerValidate="ValidateSlug" ErrorMessage="Slug may only contain lowercase letters, numbers and hyphens." CssClass="field-error" Display="Dynamic" /></label><label class="form-field">Category<asp:DropDownList ID="Category" runat="server" CssClass="input"><asp:ListItem Value="">Select a category</asp:ListItem><asp:ListItem>Programming</asp:ListItem><asp:ListItem>Web Development</asp:ListItem><asp:ListItem>Cybersecurity</asp:ListItem><asp:ListItem>Networking</asp:ListItem><asp:ListItem>Cloud</asp:ListItem><asp:ListItem>Linux</asp:ListItem><asp:ListItem>Databases</asp:ListItem></asp:DropDownList><asp:RequiredFieldValidator ID="CategoryRequired" runat="server" ControlToValidate="Category" InitialValue="" ErrorMessage="Category is required." CssClass="field-error" Display="Dynamic" /></label><label class="form-field">Level<asp:DropDownList ID="Level" runat="server" CssClass="input"><asp:ListItem>Beginner</asp:ListItem><asp:ListItem>Intermediate</asp:ListItem><asp:ListItem>Advanced</asp:ListItem></asp:DropDownList></label><label class="form-field">Estimated time (minutes)<asp:TextBox ID="EstimatedMinutes" runat="server" CssClass="input" /><asp:CustomValidator ID="MinutesRules" runat="server" ControlToValidate="EstimatedMinutes" OnServerValidate="ValidateMinutes" ErrorMessage="Estimated time must be between 10 and 1000 minutes." CssClass="field-error" Display="Dynamic" /></label><label class="form-field">Passing score (%)<asp:TextBox ID="PassingScore" runat="server" CssClass="input" /><asp:CustomValidator ID="PassingRules" runat="server" ControlToValidate="PassingScore" OnServerValidate="ValidatePassing" ErrorMessage="Passing score must be between 50 and 100." CssClass="field-error" Display="Dynamic" /></label><label class="form-field form-field-wide">Description<asp:TextBox ID="Description" runat="server" CssClass="input" TextMode="MultiLine" Rows="4" /><asp:CustomValidator ID="DescriptionRules" runat="server" ControlToValidate="Description" OnServerValidate="ValidateDescription" ErrorMessage="Description must be between 10 and 1000 characters." CssClass="field-error" Display="Dynamic" /></label><label class="form-field">Certificate name (optional)<asp:TextBox ID="CertificateName" runat="server" CssClass="input" /></label><label class="form-field">Thumbnail URL (optional)<asp:TextBox ID="ThumbnailUrl" runat="server" CssClass="input" /><asp:CustomValidator ID="ThumbnailValidator" runat="server" ControlToValidate="ThumbnailUrl" OnServerValidate="ValidateThumbnail" ErrorMessage="Thumbnail URL must be a valid HTTP or HTTPS URL." CssClass="field-error" Display="Dynamic" /></label><label class="checkbox-row"><asp:CheckBox ID="IsCertification" runat="server" /><span>Certification path</span></label><label class="checkbox-row"><asp:CheckBox ID="IsPublished" runat="server" /><span>Published</span></label></div><div class="form-actions"><a class="btn btn-ghost" href='<%= ResolveUrl("~/Admin/Courses.aspx") %>'>Cancel</a><asp:Button ID="SaveButton" runat="server" CssClass="btn btn-primary" Text="Save changes" OnClick="SaveButton_Click" /></div></div></div></section></asp:Content>