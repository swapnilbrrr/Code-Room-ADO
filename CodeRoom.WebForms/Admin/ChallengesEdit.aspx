<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="ChallengesEdit.aspx.cs" Inherits="CodeRoom.WebForms.Admin.ChallengesEdit" MasterPageFile="~/Site.Master" %>
<asp:Content ID="cTitle" ContentPlaceHolderID="TitleContent" runat="server">Edit Challenge - Code-Room</asp:Content>
<asp:Content ID="cBody" ContentPlaceHolderID="MainContent" runat="server"><section class="page-shell"><div class="container"><div class="admin-crud-header"><div><span class="eyebrow">PRACTICE LAB</span><h1 class="page-title">Edit challenge</h1></div><a class="btn btn-secondary" href='<%= ResolveUrl("~/Admin/Challenges.aspx") %>'>Back</a></div><div class="content-panel"><asp:ValidationSummary ID="Summary" runat="server" CssClass="validation-summary" /><asp:HiddenField ID="ChallengeId" runat="server" /><div class="form-grid"><label class="form-field form-field-wide">Course<asp:DropDownList ID="CourseId" runat="server" CssClass="input" AutoPostBack="true" OnSelectedIndexChanged="CourseChanged" /><asp:RequiredFieldValidator ID="CourseRequired" runat="server" ControlToValidate="CourseId" InitialValue="" ErrorMessage="Select a course." CssClass="field-error" /></label><label class="form-field form-field-wide">Lesson (optional)<asp:DropDownList ID="LessonId" runat="server" CssClass="input" /></label><label class="form-field form-field-wide">Title<asp:TextBox ID="Title" runat="server" CssClass="input" /><asp:RequiredFieldValidator ID="TitleRequired" runat="server" ControlToValidate="Title" ErrorMessage="Title is required." CssClass="field-error" /></label><label class="form-field form-field-wide">Instructions<asp:TextBox ID="Instructions" runat="server" CssClass="input" TextMode="MultiLine" Rows="7" /><asp:RequiredFieldValidator ID="InstructionsRequired" runat="server" ControlToValidate="Instructions" ErrorMessage="Instructions are required." CssClass="field-error" /></label><label class="form-field">Validation mode<asp:DropDownList ID="ValidationMode" runat="server" CssClass="input"><asp:ListItem Value="Exact">Exact answer</asp:ListItem><asp:ListItem Value="Contains">Contains phrase</asp:ListItem></asp:DropDownList></label><label class="form-field">XP points<asp:TextBox ID="Points" runat="server" CssClass="input" /><asp:CustomValidator ID="PointsRules" runat="server" ControlToValidate="Points" OnServerValidate="ValidatePoints" ErrorMessage="Points must be between 5 and 500." CssClass="field-error" /></label><label class="form-field form-field-wide">Expected answer<asp:TextBox ID="ExpectedAnswer" runat="server" CssClass="input" TextMode="MultiLine" Rows="3" /><asp:RequiredFieldValidator ID="ExpectedRequired" runat="server" ControlToValidate="ExpectedAnswer" ErrorMessage="Expected answer is required." CssClass="field-error" /></label><label class="form-field form-field-wide">Starter code (optional)<asp:TextBox ID="StarterCode" runat="server" CssClass="input" TextMode="MultiLine" Rows="5" /></label><label class="form-field form-field-wide">Hint (optional)<asp:TextBox ID="Hint" runat="server" CssClass="input" TextMode="MultiLine" Rows="3" /></label></div><div class="settings-actions"><a class="btn btn-secondary" href='<%= ResolveUrl("~/Admin/Challenges.aspx") %>'>Cancel</a><asp:Button ID="SaveButton" runat="server" CssClass="btn btn-primary" Text="Save challenge" OnClick="SaveButton_Click" /></div></div></div></section></asp:Content>