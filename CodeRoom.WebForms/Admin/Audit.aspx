<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="Audit.aspx.cs" Inherits="CodeRoom.WebForms.Admin.Audit" MasterPageFile="~/Site.Master" %>
<asp:Content ID="cTitle" ContentPlaceHolderID="TitleContent" runat="server">Audit Log - Code-Room</asp:Content>
<asp:Content ID="cBody" ContentPlaceHolderID="MainContent" runat="server"><section class="page-shell admin-dashboard"><div class="container"><div class="admin-header"><div class="admin-header-copy"><span class="eyebrow">AUDIT TRAIL</span><h1 class="page-title">Administrative activity</h1><p class="page-intro">A traceable history of platform changes made by administrators.</p></div><a class="btn btn-secondary" href='<%= ResolveUrl("~/Admin/Dashboard.aspx") %>'>Back to Admin Console</a></div><asp:Panel ID="EmptyPanel" runat="server" CssClass="empty-state" Visible="false"><div class="empty-state-icon">🧾</div><h2>No admin actions recorded yet.</h2><p>Changes to users and platform content will appear here as administrators work.</p></asp:Panel><asp:Repeater ID="AuditRepeater" runat="server"><HeaderTemplate><div class="admin-audit-table"></HeaderTemplate><ItemTemplate><div class="admin-audit-row"><div class="audit-person"><%# Eval("Initial") %></div><div class="audit-copy"><strong><%#: Eval("Action") %> · <%#: Eval("EntityType") %></strong><span><%#: Eval("Description") %></span></div><div class="audit-meta"><strong><%#: Eval("EntityName") %></strong><time><%#: Eval("Date") %></time></div></div></ItemTemplate><FooterTemplate></div></FooterTemplate></asp:Repeater></div></section></asp:Content>