<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="QuizzesManage.aspx.cs" Inherits="CodeRoom.WebForms.Admin.QuizzesManage" MasterPageFile="~/Site.Master" %>
<asp:Content ID="cTitle" ContentPlaceHolderID="TitleContent" runat="server">Quiz Questions - Code-Room</asp:Content>
<asp:Content ID="cBody" ContentPlaceHolderID="MainContent" runat="server"><section class="page-shell"><div class="container"><div class="admin-crud-header"><div><span class="eyebrow"><asp:Literal ID="CourseTitle" runat="server" /></span><h1 class="page-title"><asp:Literal ID="QuizTitle" runat="server" /> — questions</h1></div><div class="row-actions"><a class="btn btn-ghost" href='<%= ResolveUrl("~/Admin/Quizzes.aspx") %>'>Back to quizzes</a><a class="btn btn-primary" id="AddQuestionLink" runat="server">+ Add question</a></div></div><asp:Panel ID="SuccessPanel" runat="server" CssClass="alert alert-success" Visible="false"><asp:Literal ID="SuccessMessage" runat="server" /></asp:Panel><div class="content-panel"><table class="data-table"><thead><tr><th>Question</th><th>Correct</th><th>Actions</th></tr></thead><tbody><asp:Repeater ID="QuestionsRepeater" runat="server"><ItemTemplate><tr><td><%#: Eval("QuestionText") %></td><td><%# Eval("CorrectOption") %></td><td class="row-actions"><a class="btn btn-secondary btn-sm" href='<%# ResolveUrl("~/Admin/QuizzesQuestionEdit.aspx?id=" + Eval("Id")) %>'>Edit</a><asp:Button ID="DeleteButton" runat="server" CssClass="btn btn-danger btn-sm" Text="Delete" CommandArgument='<%# Eval("Id") %>' OnCommand="DeleteButton_Command" CausesValidation="false" OnClientClick="return confirm('Delete this question?');" /></td></tr></ItemTemplate></asp:Repeater><asp:Panel ID="EmptyPanel" runat="server"><tr><td colspan="3">No questions yet. Add the first one.</td></tr></asp:Panel></tbody></table></div></div></section></asp:Content>