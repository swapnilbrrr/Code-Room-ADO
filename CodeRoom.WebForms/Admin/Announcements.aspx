<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="Announcements.aspx.cs" Inherits="CodeRoom.WebForms.Admin.Announcements" MasterPageFile="~/Site.Master" %>
<asp:Content ID="cTitle" ContentPlaceHolderID="TitleContent" runat="server">Manage Announcements - Code-Room</asp:Content>
<asp:Content ID="cBody" ContentPlaceHolderID="MainContent" runat="server"><section class="page-shell"><div class="container"><div class="admin-crud-header"><div><span class="eyebrow">ANNOUNCEMENTS</span><h1 class="page-title">Manage announcements</h1></div><a class="btn btn-primary" href='<%= ResolveUrl("~/Admin/AnnouncementsCreate.aspx") %>'>+ New announcement</a></div><div class="content-panel"><table class="data-table"><thead><tr><th>Title</th><th>Published</th><th>Status</th><th>Actions</th></tr></thead><tbody><asp:Repeater ID="AnnouncementsRepeater" runat="server"><ItemTemplate><tr><td><%# Eval("Title") %></td><td><%# FormatDate(Eval("PublishedAt")) %></td><td><%# Convert.ToBoolean(Eval("IsPublished")) ? "Published" : "Hidden" %></td><td class="row-actions"><a class="btn btn-secondary btn-sm" href='<%# ResolveUrl("~/Admin/AnnouncementsEdit.aspx?id=" + Eval("Id")) %>'>Edit</a><asp:Button ID="DeleteButton" runat="server" CssClass="btn btn-danger btn-sm" Text="Delete" CommandArgument='<%# Eval("Id") %>' OnCommand="DeleteButton_Command" CausesValidation="false" OnClientClick="return confirm('Delete this announcement?');" /></td></tr></ItemTemplate></asp:Repeater><asp:Panel ID="EmptyPanel" runat="server"><tr><td colspan="4">No announcements yet.</td></tr></asp:Panel></tbody></table></div></div></section></asp:Content>