<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="LessonsEdit.aspx.cs" Inherits="CodeRoom.WebForms.Admin.LessonsEdit" MasterPageFile="~/Site.Master" %>
<asp:Content ID="cTitle" ContentPlaceHolderID="TitleContent" runat="server">Edit Lesson - Code-Room</asp:Content>
<asp:Content ID="cBody" ContentPlaceHolderID="MainContent" runat="server"><section class="page-shell"><div class="container narrow"><span class="eyebrow">LESSONS</span><h1 class="page-title">Edit lesson</h1><div class="content-panel"><asp:ValidationSummary ID="Summary" runat="server" CssClass="validation-summary" /><asp:HiddenField ID="LessonId" runat="server" /><div class="form-grid"><label class="form-field">Course<asp:DropDownList ID="CourseId" runat="server" CssClass="input" /></label><label class="form-field">Order<asp:TextBox ID="Order" runat="server" CssClass="input" /><asp:CustomValidator ID="OrderRules" runat="server" ControlToValidate="Order" OnServerValidate="ValidateOrder" ErrorMessage="Order must be between 1 and 999." CssClass="field-error" /></label><label class="form-field form-field-wide">Title<asp:TextBox ID="Title" runat="server" CssClass="input" /><asp:RequiredFieldValidator ID="TitleRequired" runat="server" ControlToValidate="Title" ErrorMessage="Title is required." CssClass="field-error" /><asp:CustomValidator ID="TitleRules" runat="server" ControlToValidate="Title" OnServerValidate="ValidateTitle" ErrorMessage="Title must be between 3 and 150 characters." CssClass="field-error" /></label><label class="form-field form-field-wide">Summary<asp:TextBox ID="SummaryText" runat="server" CssClass="input" /></label><label class="form-field">Content type<asp:DropDownList ID="ContentType" runat="server" CssClass="input"><asp:ListItem>Reading</asp:ListItem><asp:ListItem>Video</asp:ListItem><asp:ListItem>Audio</asp:ListItem><asp:ListItem>Challenge</asp:ListItem><asp:ListItem>Assessment</asp:ListItem><asp:ListItem>Final Exam</asp:ListItem></asp:DropDownList></label><label class="form-field">Duration (minutes)<asp:TextBox ID="DurationMinutes" runat="server" CssClass="input" /><asp:CustomValidator ID="DurationRules" runat="server" ControlToValidate="DurationMinutes" OnServerValidate="ValidateDuration" ErrorMessage="Duration must be between 1 and 600 minutes." CssClass="field-error" /></label><label class="form-field form-field-wide">Content<asp:TextBox ID="Content" runat="server" CssClass="input" TextMode="MultiLine" Rows="9" /><asp:RequiredFieldValidator ID="ContentRequired" runat="server" ControlToValidate="Content" ErrorMessage="Content is required." CssClass="field-error" /></label><label class="form-field">Video URL<asp:TextBox ID="VideoUrl" runat="server" CssClass="input" /></label><label class="form-field">Audio URL<asp:TextBox ID="AudioUrl" runat="server" CssClass="input" /></label><label class="form-field form-field-wide">Supporting resource URL<asp:TextBox ID="ResourceUrl" runat="server" CssClass="input" /></label><label class="checkbox-row"><asp:CheckBox ID="IsPublished" runat="server" /><span>Published</span></label></div><div class="form-actions"><a class="btn btn-ghost" href='<%= ResolveUrl("~/Admin/Lessons.aspx") %>'>Cancel</a><asp:Button ID="SaveButton" runat="server" CssClass="btn btn-primary" Text="Save changes" OnClick="SaveButton_Click" /></div></div></div></section></asp:Content>