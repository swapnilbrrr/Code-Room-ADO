<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="Courses.aspx.cs" Inherits="CodeRoom.WebForms.Admin.Courses" MasterPageFile="~/Site.Master" %>
<asp:Content ID="cTitle" ContentPlaceHolderID="TitleContent" runat="server">Manage Courses - Code-Room</asp:Content>
<asp:Content ID="cBody" ContentPlaceHolderID="MainContent" runat="server"><section class="page-shell"><div class="container"><div class="admin-crud-header"><div><span class="eyebrow">COURSES</span><h1 class="page-title">Manage courses</h1></div><a class="btn btn-primary" href='<%= ResolveUrl("~/Admin/CoursesCreate.aspx") %>'>+ New course</a></div><asp:Panel ID="SuccessPanel" runat="server" CssClass="alert alert-success" Visible="false"><asp:Literal ID="SuccessMessage" runat="server" /></asp:Panel><div class="content-panel"><table class="data-table"><thead><tr><th>Title</th><th>Category</th><th>Level</th><th>Lessons</th><th>Status</th><th>Actions</th></tr></thead><tbody><asp:Repeater ID="CoursesRepeater" runat="server"><ItemTemplate><tr><td><%#: Eval("Title") %></td><td><%#: Eval("Category") %></td><td><%#: Eval("Level") %></td><td><%# Eval("Lessons.Count") %></td><td><%# Convert.ToBoolean(Eval("IsPublished")) ? "Published" : "Draft" %></td><td class="row-actions"><a class="btn btn-secondary btn-sm" href='<%# ResolveUrl("~/Admin/CoursesEdit.aspx?id=" + Eval("Id")) %>'>Edit</a><asp:Button ID="DeleteButton" runat="server" CssClass="btn btn-danger btn-sm" Text="Delete" CommandArgument='<%# Eval("Id") %>' OnCommand="DeleteButton_Command" CausesValidation="false" OnClientClick="return confirm('Delete this course and its lessons?');" /></td></tr></ItemTemplate></asp:Repeater><asp:Panel ID="EmptyPanel" runat="server"><tr><td colspan="6">No courses yet.</td></tr></asp:Panel></tbody></table></div></div></section></asp:Content>