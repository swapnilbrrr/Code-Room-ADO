<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="Challenges.aspx.cs" Inherits="CodeRoom.WebForms.Admin.Challenges" MasterPageFile="~/Site.Master" %>
<asp:Content ID="cTitle" ContentPlaceHolderID="TitleContent" runat="server">Manage Challenges - Code-Room</asp:Content>
<asp:Content ID="cBody" ContentPlaceHolderID="MainContent" runat="server"><section class="page-shell"><div class="container"><div class="admin-crud-header"><div><span class="eyebrow">PRACTICE LAB</span><h1 class="page-title">Manage challenges</h1><p class="page-intro">Create short tasks that turn course concepts into hands-on practice.</p></div><a class="btn btn-primary" href='<%= ResolveUrl("~/Admin/ChallengesCreate.aspx") %>'>+ New challenge</a></div><div class="content-panel"><table class="data-table"><thead><tr><th>Challenge</th><th>Course</th><th>Points</th><th>Mode</th><th>Actions</th></tr></thead><tbody><asp:Repeater ID="ChallengesRepeater" runat="server"><ItemTemplate><tr><td><strong><%#: Eval("Title") %></strong></td><td><%#: Eval("CourseTitle") %></td><td>+<%# Eval("Points") %> XP</td><td><%#: Eval("ValidationMode") %></td><td class="row-actions"><a class="btn btn-secondary btn-sm" href='<%# ResolveUrl("~/Admin/ChallengesEdit.aspx?id=" + Eval("Id")) %>'>Edit</a><asp:Button ID="DeleteButton" runat="server" CssClass="btn btn-danger btn-sm" Text="Delete" CommandArgument='<%# Eval("Id") %>' OnCommand="DeleteButton_Command" CausesValidation="false" OnClientClick="return confirm('Delete this challenge?');" /></td></tr></ItemTemplate></asp:Repeater><asp:Panel ID="EmptyPanel" runat="server"><tr><td colspan="5">No challenges yet.</td></tr></asp:Panel></tbody></table></div></div></section></asp:Content>