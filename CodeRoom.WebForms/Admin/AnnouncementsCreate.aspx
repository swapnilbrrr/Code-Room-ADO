<%@ Page Language="C#" AutoEventWireup="true" CodeBehind="AnnouncementsCreate.aspx.cs" Inherits="CodeRoom.WebForms.Admin.AnnouncementsCreate" MasterPageFile="~/Site.Master" %>
<asp:Content ID="cTitle" ContentPlaceHolderID="TitleContent" runat="server">New Announcement - Code-Room</asp:Content>
<asp:Content ID="cBody" ContentPlaceHolderID="MainContent" runat="server"><section class="page-shell"><div class="container narrow"><span class="eyebrow">ANNOUNCEMENTS</span><h1 class="page-title">New announcement</h1><div class="content-panel"><asp:ValidationSummary ID="Summary" runat="server" CssClass="validation-summary" /><div class="form-grid"><label class="form-field form-field-wide">Title<asp:TextBox ID="Title" runat="server" CssClass="input" /><asp:RequiredFieldValidator ID="TitleRequired" runat="server" ControlToValidate="Title" ErrorMessage="Title is required." CssClass="field-error" /></label><label class="form-field form-field-wide">Message<asp:TextBox ID="Message" runat="server" CssClass="input" TextMode="MultiLine" Rows="5" /><asp:RequiredFieldValidator ID="MessageRequired" runat="server" ControlToValidate="Message" ErrorMessage="Message is required." CssClass="field-error" /></label><label class="form-field">Published date<asp:TextBox ID="PublishedAt" runat="server" CssClass="input" TextMode="SingleLine" /></label><label class="checkbox-row"><asp:CheckBox ID="IsPublished" runat="server" Checked="true" /><span>Published (visible to students)</span></label></div><div class="form-actions"><a class="btn btn-ghost" href='<%= ResolveUrl("~/Admin/Announcements.aspx") %>'>Cancel</a><asp:Button ID="SaveButton" runat="server" CssClass="btn btn-primary" Text="Create announcement" OnClick="SaveButton_Click" /></div></div></div></section></asp:Content>